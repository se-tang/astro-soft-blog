---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteSettings } from '../lib/site';
import { renderMarkdown } from '../lib/markdown';

const env = Astro.locals.runtime?.env;
const siteSettings = await getSiteSettings(env);
const { html } = renderMarkdown(siteSettings.aboutContent || '');
---

<BaseLayout title={`关于 | ${siteSettings.title}`} description={`关于 ${siteSettings.title}`}>
  <article class="glass-panel article-panel">
    <header class="article-header">
      <h1 class="article-title">关于 {siteSettings.title}</h1>
      <p class="guides-lede">{siteSettings.subtitle}</p>
    </header>
    <div class="prose" set:html={html} />
  </article>
</BaseLayout>
