---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPosts } from '../lib/posts';
import { getSiteSettings } from '../lib/site';
import { Calendar, FolderOpen, ArrowRight } from 'lucide-astro';

const siteSettings = getSiteSettings();
const allPosts = getAllPosts(false);

const categoryCounts = new Map<string, number>();
for (const post of allPosts) {
  categoryCounts.set(post.category, (categoryCounts.get(post.category) ?? 0) + 1);
}
const categories = Array.from(categoryCounts.entries());
---

<BaseLayout
  title={`${siteSettings.title} | ${siteSettings.subtitle}`}
  description={siteSettings.description}
>
  <section class="glass-panel guides-header">
    <h1 class="guides-h1">{siteSettings.title} · {siteSettings.subtitle}</h1>
    <p class="guides-lede">{siteSettings.description}</p>
    <p class="guides-count">共收录 {allPosts.length} 篇文章 · {categories.length} 个分类</p>
  </section>

  <div class="guides-tabs" role="tablist" aria-label="文章分类筛选">
    <button type="button" class="guides-tab active" data-category="all">
      全部 <span class="guides-tab-count">{allPosts.length}</span>
    </button>
    {categories.map(([cat, count]) => (
      <button type="button" class="guides-tab" data-category={cat}>
        {cat} <span class="guides-tab-count">{count}</span>
      </button>
    ))}
  </div>

  <ul class="guides-list" id="post-list">
    {allPosts.map((post) => (
      <li class="glass-panel post-card" data-category={post.category}>
        <a href={`/posts/${post.slug}/`} class="post-card-link">
          <div class="post-card-meta">
            <span class="post-category-badge">
              <FolderOpen size={12} style="display:inline;vertical-align:-2px;margin-right:4px;" />
              {post.category}
            </span>
            <span>
              <Calendar size={12} style="display:inline;vertical-align:-2px;margin-right:4px;" />
              {post.pubDate}
            </span>
          </div>
          <h2 class="post-card-title">{post.title}</h2>
          <p class="post-card-desc">{post.description}</p>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
            <div class="post-tags">
              {post.tags.map((tag) => (
                <span class="post-tag">#{tag}</span>
              ))}
            </div>
            <span style="font-size:0.8rem;font-weight:700;color:var(--neon-cyan);display:inline-flex;align-items:center;gap:4px;">
              阅读全文 <ArrowRight size={14} />
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <script is:inline>
    (function () {
      var tabs = document.querySelectorAll('.guides-tab');
      var cards = document.querySelectorAll('#post-list .post-card');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var selected = tab.getAttribute('data-category');
          tabs.forEach(function (t) { t.classList.remove('active'); });
          tab.classList.add('active');
          cards.forEach(function (card) {
            var cat = card.getAttribute('data-category');
            card.style.display = (selected === 'all' || cat === selected) ? '' : 'none';
          });
        });
      });
    })();
  </script>
</BaseLayout>
