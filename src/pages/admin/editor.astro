---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAuthenticated } from '../../lib/auth';
import { getAllPosts, getPostBySlug } from '../../lib/posts';
import { Save, Send, ArrowLeft } from 'lucide-astro';

const env = Astro.locals.runtime?.env;
if (!(await isAuthenticated(Astro.cookies, env))) {
  return Astro.redirect('/admin/login/');
}

const slugParam = Astro.url.searchParams.get('slug') || '';
const editingPost = slugParam ? await getPostBySlug(env, slugParam, true) : null;
const allCategories = Array.from(new Set((await getAllPosts(env, true)).map((p) => p.category)));
const today = new Date().toISOString().slice(0, 10);
---

<AdminLayout title={editingPost ? `编辑：${editingPost.title}` : '写新文章'} activeNav="editor">
  <div class="admin-topbar">
    <div style="display:flex;align-items:center;gap:12px;">
      <a href="/admin/" class="admin-btn" style="height:34px;">
        <ArrowLeft size={14} /> 返回列表
      </a>
      <h1 class="admin-page-title">{editingPost ? '编辑文章' : '写新文章'}</h1>
    </div>

    <div style="display:flex;align-items:center;gap:10px;">
      <span id="save-toast" style="font-size:0.82rem;font-weight:700;color:var(--neon-green);display:none;"></span>
      <button type="button" id="save-draft-btn" class="admin-btn">
        <Save size={14} /> <span>存为草稿</span>
      </button>
      <button type="button" id="publish-btn" class="admin-btn admin-btn-primary">
        <Send size={14} /> <span>发布文章</span>
      </button>
    </div>
  </div>

  <div class="editor-layout">
    <!-- 左侧主编辑区：标题 + 分屏 Markdown 编辑与 0ms 实时预览 -->
    <div style="display:flex;flex-direction:column;gap:14px;min-width:0;">
      <div class="glass-panel" style="padding:14px 16px;">
        <input
          type="text"
          id="post-title"
          class="admin-input"
          value={editingPost ? editingPost.title : ''}
          placeholder="输入文章标题..."
          style="font-size:1.15rem;font-weight:800;border:none;background:transparent;padding:4px 0;"
        />
      </div>

      <div class="editor-split">
        <div class="glass-panel editor-pane">
          <div class="editor-toolbar-row">
            <button type="button" class="editor-tool-btn" data-insert="## ">H2</button>
            <button type="button" class="editor-tool-btn" data-insert="### ">H3</button>
            <button type="button" class="editor-tool-btn" data-wrap="**">加粗</button>
            <button type="button" class="editor-tool-btn" data-wrap="`">行内代码</button>
            <button type="button" class="editor-tool-btn" data-insert="\n> ">引用</button>
            <button type="button" class="editor-tool-btn" data-insert="\n```bash\n\n```\n">代码块</button>
            <button type="button" class="editor-tool-btn" data-insert="[链接文字](https://)">链接</button>
            <button
              type="button"
              class="editor-tool-btn"
              data-insert="\n> [!IMPORTANT]\n> 这里填写重要提示内容\n"
            >
              IMPORTANT
            </button>
            <button
              type="button"
              class="editor-tool-btn"
              data-insert="\n:::: tabs\n::: tab-item 📝 概览\n第一页内容\n:::\n::: tab-item ⚙️ 配置\n第二页内容\n:::\n::::\n"
            >
              Tabs
            </button>
            <button
              type="button"
              class="editor-tool-btn"
              data-insert="\n<details>\n<summary>点击展开查看详情</summary>\n\n这里写折叠内容……\n\n</details>\n"
            >
              折叠块
            </button>
          </div>
          <textarea
            id="post-content"
            class="editor-textarea"
            placeholder="使用 Markdown 编写正文..."
          >{editingPost ? editingPost.content : ''}</textarea>
        </div>

        <div class="glass-panel editor-pane">
          <div class="editor-toolbar-row" style="justify-content:space-between;">
            <span style="font-size:0.78rem;font-weight:700;color:var(--text-secondary);">实时预览</span>
          </div>
          <div
            id="post-preview"
            class="editor-preview prose"
            set:html={editingPost ? editingPost.html : '<p style="color:var(--text-secondary);">输入 Markdown 内容即可实时预览...</p>'}
          />
        </div>
      </div>
    </div>

    <!-- 右侧属性设置栏 -->
    <aside class="glass-panel editor-drawer">
      <h2 style="margin:0 0 4px;font-size:0.98rem;font-weight:800;">文章设置</h2>

      <div class="form-field">
        <label for="post-slug">访问路径 (Slug)</label>
        <input
          type="text"
          id="post-slug"
          class="admin-input"
          value={editingPost ? editingPost.slug : ''}
          placeholder="如 my-first-post（留空自动生成）"
          style="font-family:var(--font-mono);font-size:0.82rem;"
        />
      </div>

      <div class="form-field">
        <label for="post-category">文章分类（可输入新分类）</label>
        <input
          type="text"
          id="post-category"
          class="admin-input"
          list="category-options"
          value={editingPost ? editingPost.category : '随笔'}
          placeholder="如：新手指南 / 随笔"
        />
        <datalist id="category-options">
          {allCategories.map((cat) => (
            <option value={cat} />
          ))}
        </datalist>
      </div>

      <div class="form-field">
        <label for="post-tags">文章标签（用逗号分隔）</label>
        <input
          type="text"
          id="post-tags"
          class="admin-input"
          value={editingPost ? editingPost.tags.join(', ') : ''}
          placeholder="如：Cloudflare, Astro, 教程"
        />
      </div>

      <div class="form-field">
        <label for="post-date">发布日期</label>
        <input
          type="date"
          id="post-date"
          class="admin-input"
          value={editingPost ? editingPost.pubDate : today}
          style="font-family:var(--font-mono);"
        />
      </div>

      <div class="form-field">
        <label for="post-desc">文章摘要</label>
        <textarea
          id="post-desc"
          class="admin-textarea"
          rows="3"
          placeholder="一句话概括这篇文章..."
        >{editingPost ? editingPost.description : ''}</textarea>
      </div>

      <input type="hidden" id="original-slug" value={editingPost ? editingPost.slug : ''} />
    </aside>
  </div>

  <script>
    import { renderMarkdown } from '../../lib/markdown';

    const titleEl = document.getElementById('post-title') as HTMLInputElement;
    const slugEl = document.getElementById('post-slug') as HTMLInputElement;
    const origSlugEl = document.getElementById('original-slug') as HTMLInputElement;
    const catEl = document.getElementById('post-category') as HTMLInputElement;
    const tagsEl = document.getElementById('post-tags') as HTMLInputElement;
    const dateEl = document.getElementById('post-date') as HTMLInputElement;
    const descEl = document.getElementById('post-desc') as HTMLTextAreaElement;
    const contentEl = document.getElementById('post-content') as HTMLTextAreaElement;
    const previewEl = document.getElementById('post-preview') as HTMLElement;
    const toastEl = document.getElementById('save-toast') as HTMLElement;
    const draftBtn = document.getElementById('save-draft-btn') as HTMLButtonElement;
    const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement;

    function updatePreviewNow() {
      if (!contentEl || !previewEl) return;
      const val = contentEl.value;
      if (!val.trim()) {
        previewEl.innerHTML = '<p style="color:var(--text-secondary);">输入 Markdown 内容即可实时预览...</p>';
        return;
      }
      const { html } = renderMarkdown(val);
      previewEl.innerHTML = html;
    }

    // 0ms 本地即时渲染
    if (contentEl) {
      contentEl.addEventListener('input', updatePreviewNow);
    }

    // 编辑器与预览区双向同步滚动
    let syncingFromEditor = false;
    let syncingFromPreview = false;

    if (contentEl && previewEl) {
      contentEl.addEventListener('scroll', () => {
        if (syncingFromPreview) return;
        syncingFromEditor = true;
        const maxEditor = contentEl.scrollHeight - contentEl.clientHeight;
        const maxPreview = previewEl.scrollHeight - previewEl.clientHeight;
        if (maxEditor > 0 && maxPreview > 0) {
          previewEl.scrollTop = (contentEl.scrollTop / maxEditor) * maxPreview;
        }
        requestAnimationFrame(() => { syncingFromEditor = false; });
      });

      previewEl.addEventListener('scroll', () => {
        if (syncingFromEditor) return;
        syncingFromPreview = true;
        const maxEditor = contentEl.scrollHeight - contentEl.clientHeight;
        const maxPreview = previewEl.scrollHeight - previewEl.clientHeight;
        if (maxEditor > 0 && maxPreview > 0) {
          contentEl.scrollTop = (previewEl.scrollTop / maxPreview) * maxEditor;
        }
        requestAnimationFrame(() => { syncingFromPreview = false; });
      });
    }

    // 预览区内的 Tabs 切换支持
    if (previewEl) {
      previewEl.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const btn = target.closest('.md-tab-btn');
        if (!btn) return;
        const container = btn.closest('.md-tabs');
        if (!container) return;
        const idx = btn.getAttribute('data-tab-idx');
        container.querySelectorAll('.md-tab-btn').forEach((b) => {
          b.classList.toggle('active', b.getAttribute('data-tab-idx') === idx);
        });
        container.querySelectorAll('.md-tab-panel').forEach((p) => {
          p.classList.toggle('active', p.getAttribute('data-tab-idx') === idx);
        });
      });
    }

    // 快捷工具栏
    document.querySelectorAll('.editor-tool-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!contentEl) return;
        const start = contentEl.selectionStart;
        const end = contentEl.selectionEnd;
        const val = contentEl.value;
        const insert = btn.getAttribute('data-insert');
        const wrap = btn.getAttribute('data-wrap');

        if (wrap) {
          const selected = val.slice(start, end) || '文字';
          contentEl.value = val.slice(0, start) + wrap + selected + wrap + val.slice(end);
          contentEl.focus();
        } else if (insert) {
          const text = insert.replace(/\\n/g, '\n');
          contentEl.value = val.slice(0, start) + text + val.slice(end);
          contentEl.focus();
        }
        updatePreviewNow();
      });
    });

    let isSaving = false;
    async function savePost(isDraft: boolean) {
      if (isSaving) return;
      const title = titleEl.value.trim();
      if (!title) {
        alert('请先输入文章标题');
        titleEl.focus();
        return;
      }

      isSaving = true;
      draftBtn.disabled = true;
      publishBtn.disabled = true;
      const draftLabel = draftBtn.querySelector('span');
      const pubLabel = publishBtn.querySelector('span');
      if (isDraft && draftLabel) draftLabel.textContent = '保存中...';
      if (!isDraft && pubLabel) pubLabel.textContent = '发布中...';

      try {
        const res = await fetch('/api/admin/posts', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            title,
            slug: slugEl.value.trim() || title,
            originalSlug: origSlugEl.value.trim(),
            category: catEl.value.trim() || '随笔',
            tags: tagsEl.value,
            pubDate: dateEl.value,
            description: descEl.value.trim(),
            draft: isDraft,
            content: contentEl.value,
          }),
        });
        const data = await res.json();
        if (!data.ok) throw new Error(data.error || '保存失败');

        origSlugEl.value = data.post.slug;
        slugEl.value = data.post.slug;
        toastEl.textContent = isDraft ? '草稿已保存' : '文章已发布！';
        toastEl.style.display = 'inline';
        setTimeout(() => { toastEl.style.display = 'none'; }, 2500);
        if (!window.location.search.includes('slug=')) {
          history.replaceState(null, '', '/admin/editor/?slug=' + encodeURIComponent(data.post.slug));
        }
      } catch (err: any) {
        alert(err?.message || '保存出错');
      } finally {
        isSaving = false;
        draftBtn.disabled = false;
        publishBtn.disabled = false;
        if (draftLabel) draftLabel.textContent = '存为草稿';
        if (pubLabel) pubLabel.textContent = '发布文章';
      }
    }

    draftBtn.addEventListener('click', () => savePost(true));
    publishBtn.addEventListener('click', () => savePost(false));
  </script>
</AdminLayout>
