---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Calendar, FolderOpen, ArrowLeft, BookOpen, List, ArrowUp } from 'lucide-astro';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

function formatDate(date: Date) {
  return date.toISOString().slice(0, 10);
}
---

<BaseLayout title={`${post.data.title} | Soft-Blog`} description={post.data.description} wide={true}>
  <nav class="breadcrumbs" aria-label="面包屑导航">
    <a href="/" class="bc-link">首页</a>
    <span class="bc-sep">/</span>
    <span class="bc-current">{post.data.title}</span>
  </nav>

  <div class="doc-shell">
    <!-- 左侧：文章汇览 -->
    <aside class="glass-panel doc-sidebar" aria-label="文章汇览">
      <div class="sidebar-header">
        <span class="sidebar-title">
          <BookOpen size={15} style="color: var(--neon-cyan);" />
          文章汇览
        </span>
        <span class="sidebar-count">{allPosts.length}</span>
      </div>
      <nav class="sidebar-nav">
        {allPosts.map((item) => (
          <a
            href={`/posts/${item.id}/`}
            class:list={['doc-nav-item', { active: item.id === post.id }]}
            title={item.data.title}
          >
            <span class="dni-dot" aria-hidden="true"></span>
            <span class="dni-title">{item.data.title}</span>
          </a>
        ))}
      </nav>
    </aside>

    <!-- 中间：文章正文 -->
    <div class="doc-main">
      <article class="glass-panel article-panel">
        <header class="article-header">
          <div class="post-card-meta" style="margin-bottom: 12px;">
            <span class="post-category-badge">
              <FolderOpen size={12} style="display:inline;vertical-align:-2px;margin-right:4px;" />
              {post.data.category}
            </span>
            <span>
              <Calendar size={12} style="display:inline;vertical-align:-2px;margin-right:4px;" />
              发布于 {formatDate(post.data.pubDate)}
            </span>
          </div>
          <h1 class="article-title">{post.data.title}</h1>
          <p class="guides-lede" style="margin-top: 12px;">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="post-tags" style="margin-top: 14px;">
              {post.data.tags.map((tag) => (
                <span class="post-tag">#{tag}</span>
              ))}
            </div>
          )}
        </header>

        <div class="prose" id="article-prose">
          <Content />
        </div>
      </article>

      <div style="margin-top: 20px;">
        <a href="/" class="nav-link" style="display:inline-flex;align-items:center;gap:6px;">
          <ArrowLeft size={15} /> 返回文章列表
        </a>
      </div>
    </div>

    <!-- 右侧：本篇目录 -->
    <aside class="glass-panel doc-toc-sidebar" aria-label="本篇目录">
      <div class="toc-title">
        <List size={15} style="color: var(--neon-cyan);" />
        本篇目录
      </div>
      {tocHeadings.length > 0 ? (
        <nav class="toc-list" id="toc-list">
          {tocHeadings.map((h) => (
            <a
              href={`#${h.slug}`}
              class:list={['toc-item', `toc-h${h.depth}`]}
              data-toc-id={h.slug}
            >
              {h.text}
            </a>
          ))}
        </nav>
      ) : (
        <div class="toc-empty">本篇暂无小节目录</div>
      )}
      <div class="toc-actions">
        <button type="button" id="back-to-top" class="toc-action-btn">
          <ArrowUp size={13} /> 回到顶部
        </button>
      </div>
    </aside>
  </div>

  <script is:inline>
    (function () {
      var backBtn = document.getElementById('back-to-top');
      if (backBtn) {
        backBtn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      var tocLinks = Array.from(document.querySelectorAll('#toc-list .toc-item'));
      var tocSidebar = document.querySelector('.doc-toc-sidebar');
      var prose = document.getElementById('article-prose');
      if (!tocLinks.length || !prose) return;

      var headings = Array.from(prose.querySelectorAll('h2[id], h3[id], h4[id]'));
      if (!headings.length) return;

      var currentId = '';
      function setActive(id) {
        if (!id || id === currentId) return;
        currentId = id;
        var activeEl = null;
        tocLinks.forEach(function (link) {
          var matched = link.getAttribute('data-toc-id') === id;
          link.classList.toggle('active', matched);
          if (matched) activeEl = link;
        });
        if (activeEl && tocSidebar) {
          var sRect = tocSidebar.getBoundingClientRect();
          var aRect = activeEl.getBoundingClientRect();
          if (aRect.top < sRect.top + 40 || aRect.bottom > sRect.bottom - 40) {
            tocSidebar.scrollTo({
              top: tocSidebar.scrollTop + (aRect.top - sRect.top) - sRect.height / 2 + aRect.height / 2,
              behavior: 'smooth',
            });
          }
        }
      }

      function updateActiveByScroll() {
        var nearBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 40;
        if (nearBottom) {
          setActive(headings[headings.length - 1].id);
          return;
        }
        var active = headings[0].id;
        for (var i = 0; i < headings.length; i++) {
          if (headings[i].getBoundingClientRect().top <= 110) {
            active = headings[i].id;
          } else {
            break;
          }
        }
        setActive(active);
      }

      var ticking = false;
      window.addEventListener('scroll', function () {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(function () {
            updateActiveByScroll();
            ticking = false;
          });
        }
      }, { passive: true });

      updateActiveByScroll();
    })();
  </script>
</BaseLayout>
